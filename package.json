{
  "name": "svedocs-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit-native documentation framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backrunner/svedocs.git"
  },
  "bugs": {
    "url": "https://github.com/backrunner/svedocs/issues"
  },
  "homepage": "https://github.com/backrunner/svedocs#readme",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "check": "turbo check",
    "lint": "turbo lint",
    "pack:dry-run": "turbo pack:dry-run",
    "publish:cli": "node --experimental-strip-types scripts/publish-cli.ts",
    "publish:npm": "node --experimental-strip-types scripts/publish-npm.ts",
    "deploy:site": "pnpm --filter svedocs build && pnpm --filter @svedocs/site check && SVEDOCS_BUILD_MODE=edge pnpm --filter @svedocs/site build && wrangler deploy",
    "deploy:site:dry-run": "pnpm --filter svedocs build && pnpm --filter @svedocs/site check && SVEDOCS_BUILD_MODE=edge pnpm --filter @svedocs/site build && wrangler deploy --dry-run",
    "test:templates": "SVEDOCS_TEMPLATE_E2E=1 pnpm --filter svedocs-cli test",
    "test:e2e": "pnpm --filter @svedocs/site test:e2e",
    "release:check": "pnpm build && pnpm check && pnpm test && pnpm lint && pnpm pack:dry-run",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm release:check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/adapter-cloudflare": "8.0.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.6.5",
    "commander": "15.0.0",
    "cross-spawn": "7.0.6",
    "fast-glob": "3.3.3",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-to-string": "3.0.1",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.150.0",
    "zod": "4.6.7"
  }
}
