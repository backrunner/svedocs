{
  "name": "svedocs-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit-native documentation framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backrunner/svedocs.git"
  },
  "bugs": {
    "url": "https://github.com/backrunner/svedocs/issues"
  },
  "homepage": "https://github.com/backrunner/svedocs#readme",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "check": "turbo check",
    "lint": "turbo lint",
    "pack:dry-run": "turbo pack:dry-run",
    "publish:cli": "node --experimental-strip-types scripts/publish-cli.ts",
    "publish:npm": "node --experimental-strip-types scripts/publish-npm.ts",
    "test:templates": "SVEDOCS_TEMPLATE_E2E=1 pnpm --filter svedocs-cli test",
    "test:e2e": "pnpm --filter @svedocs/site test:e2e",
    "release:check": "pnpm build && pnpm check && pnpm test && pnpm lint && pnpm pack:dry-run",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm release:check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@playwright/test": "1.60.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-cloudflare": "7.2.8",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.60.1",
    "@sveltejs/package": "2.5.7",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.8.0",
    "commander": "14.0.3",
    "fast-glob": "3.3.3",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-to-string": "3.0.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.0.2",
    "svelte": "5.55.7",
    "tailwindcss": "4.3.0",
    "tsup": "8.5.1",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.0.13",
    "vitest": "4.1.6",
    "wrangler": "4.92.0",
    "zod": "4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
