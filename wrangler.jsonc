{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svedocs",
  "main": "apps/site/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "apps/site/.svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "ai_search": [
    {
      "binding": "SVEDOCS_AI_SEARCH",
      "instance_name": "svedocs",
      "remote": true
    }
  ]
}
