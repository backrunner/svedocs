{
  "name": "@svedocs/site",
  "version": "0.0.0",
  "private": true,
  "description": "Official svedocs site and live demo.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "vitest run --passWithNoTests --exclude \"e2e/**\"",
    "test:e2e": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev --host 0.0.0.0"
  },
  "dependencies": {
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/adapter-cloudflare": "8.0.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3",
    "svedocs": "workspace:*"
  },
  "devDependencies": {
    "vite": "8.3.4"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
