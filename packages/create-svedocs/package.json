{
  "name": "create-svedocs",
  "version": "0.1.0-beta.5",
  "description": "Compatibility package for npm create svedocs and pnpm create svedocs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backrunner/svedocs.git",
    "directory": "packages/create-svedocs"
  },
  "bugs": {
    "url": "https://github.com/backrunner/svedocs/issues"
  },
  "homepage": "https://github.com/backrunner/svedocs/tree/main/packages/create-svedocs#readme",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "create-svedocs": "./bin/create-svedocs.js"
  },
  "exports": {
    ".": {
      "import": "./bin/create-svedocs.js"
    }
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/check-shim.mjs",
    "test": "node scripts/check-shim.mjs",
    "check": "node scripts/check-shim.mjs",
    "lint": "node scripts/check-shim.mjs",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "dependencies": {
    "svedocs-cli": "workspace:*"
  }
}
