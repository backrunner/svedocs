{
  "name": "svedocs-minimal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svedocs dev",
    "build": "svedocs build",
    "build:edge": "svedocs build --mode edge",
    "build:static": "svedocs build --mode static",
    "build:ssg": "svedocs ssg",
    "build:spa": "svedocs build --mode spa",
    "preview": "svedocs preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.2",
    "svedocs": "latest",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "wrangler": "4.150.0"
  },
  "devDependencies": {
    "svedocs-cli": "latest",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "svelte-check": "^4.7.6"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
