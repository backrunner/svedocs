{
  "name": "svedocs-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svedocs dev",
    "build": "svedocs build",
    "build:edge": "svedocs build --mode edge",
    "build:static": "svedocs build --mode static",
    "build:ssg": "svedocs ssg",
    "build:spa": "svedocs build --mode spa",
    "preview": "svedocs preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.3",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "svelte": "^5.59.1",
    "svedocs": "latest",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "wrangler": "4.166.0"
  },
  "devDependencies": {
    "svedocs-cli": "latest",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "svelte-check": "^4.7.8"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
