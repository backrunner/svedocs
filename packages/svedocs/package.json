{
  "name": "svedocs",
  "version": "0.1.1-beta.1",
  "description": "SvelteKit-native documentation framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backrunner/svedocs.git",
    "directory": "packages/svedocs"
  },
  "bugs": {
    "url": "https://github.com/backrunner/svedocs/issues"
  },
  "homepage": "https://github.com/backrunner/svedocs/tree/main/packages/svedocs#readme",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "svelte": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./theme": {
      "svelte": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./theme/styles.css": {
      "default": "./dist/theme/styles.css"
    },
    "./theme/base.css": {
      "default": "./dist/theme/base.css"
    },
    "./theme/headless": {
      "types": "./dist/theme/headless.d.ts",
      "import": "./dist/theme/headless.js"
    },
    "./theme/types": {
      "types": "./dist/theme/types.d.ts",
      "import": "./dist/theme/types.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./og": {
      "types": "./dist/og.d.ts",
      "import": "./dist/og.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm pack --dry-run",
    "dev": "svelte-package -i src -o dist --watch"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "fast-glob": "3.3.3",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-to-string": "3.0.0",
    "katex": "0.16.47",
    "mdsvex": "0.12.7",
    "minisearch": "7.2.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "satori": "0.26.0",
    "shiki": "4.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2.0.0",
    "svelte": ">=5.0.0",
    "vite": ">=8.0.0"
  }
}
